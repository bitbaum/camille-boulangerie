  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "espree": "^11.2.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
