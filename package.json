{
  "name": "camille-boulangerie",
  "version": "0.2.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
